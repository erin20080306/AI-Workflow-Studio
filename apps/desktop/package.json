{
  "name": "@ai-workflow-studio/desktop",
  "version": "0.2.0",
  "private": true,
  "author": "AI Workflow Studio",
  "description": "AI Workflow Studio local Desktop Agent",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "dev": "pnpm build && electron .",
    "package:test": "pnpm build && electron-builder --config electron-builder.dev.yml --dir --publish never && node ./ad-hoc-sign-test-macos.mjs",
    "package:store:windows": "pnpm build && electron-builder --config electron-builder.store.yml --win appx --x64 --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@ai-workflow-studio/agent-protocol": "workspace:*",
    "@ai-workflow-studio/local-executor": "workspace:*",
    "@ai-workflow-studio/run-orchestrator": "workspace:*",
    "@ai-workflow-studio/shared": "workspace:*",
    "@ai-workflow-studio/workflow-engine": "workspace:*",
    "@ai-workflow-studio/workflow-schema": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "zod": "^4.3.6"
  }
}
