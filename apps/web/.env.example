# Public browser configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current browser key. The legacy anonymous key remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MOCK_MODE=true

# Supabase server access
SUPABASE_SERVICE_ROLE_KEY=

# Application cryptography
# Exactly 32 random bytes encoded as padded base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
AGENT_TOKEN_PEPPER=

# Google Sheets OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Google OAuth client callback.
GOOGLE_REDIRECT_URI=

# Optional AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Microsoft Store service-to-service entitlement verification
# The client secret and Store ID keys must never use NEXT_PUBLIC_ variables.
MICROSOFT_STORE_TENANT_ID=
MICROSOFT_STORE_CLIENT_ID=
MICROSOFT_STORE_CLIENT_SECRET=
# JSON array, for example:
# [{"plan":"pro","productId":"9...","skuId":"monthly"}]
MICROSOFT_STORE_PLAN_MAPPINGS=

# Protected scheduled endpoints
CRON_SECRET=

# Optional customer custom-domain automation (server-only Vercel REST API)
# Use a narrowly scoped Vercel access token with project domain permissions.
VERCEL_CUSTOM_DOMAIN_TOKEN=
VERCEL_CUSTOM_DOMAIN_PROJECT_ID=
VERCEL_CUSTOM_DOMAIN_TEAM_ID=
